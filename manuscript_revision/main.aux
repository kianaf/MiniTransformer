\BKM@entry{id=20,open,dest={417070656E6469782E312E44},srcline={827}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {B3}{\ignorespaces Per-variable p-value distributions on a generatively-null target ($\mathrm {predindex}=5$, the variable shown in row 6). Mean rejection rate at $\alpha =0.05$ across the nine non-self variables is $0.064$, close to the nominal level. The self-context case (variable $5$) is a degenerate special case and should be excluded by convention.}}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:supp_calibration_null_hist}{{B3}{14}{Per-variable p-value distributions on a generatively-null target ($\mathrm {predindex}=5$, the variable shown in row 6). Mean rejection rate at $\alpha =0.05$ across the nine non-self variables is $0.064$, close to the nominal level. The self-context case (variable $5$) is a degenerate special case and should be excluded by convention}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {C4}{\ignorespaces Sensitivity of the permutation test to the visit-sample size $V$. Left: mean p-value per variable across $\mathrm {nrepp}=500$ repetitions. Centre: empirical rejection rate at $\alpha =0.05$. Right: Kolmogorov-Smirnov distance to $\mathrm {Uniform}[0,1]$. Red lines: data-generating-process signal variables ($j_1$, $j_2$, $j_3$). Blue lines: data-generating-process null variables ($3$--$9$). All seven blue lines in the centre panel sit on the $y=0$ axis at every $V$.}}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:supp_v_sweep}{{C4}{14}{Sensitivity of the permutation test to the visit-sample size $V$. Left: mean p-value per variable across $\mathrm {nrepp}=500$ repetitions. Centre: empirical rejection rate at $\alpha =0.05$. Right: Kolmogorov-Smirnov distance to $\mathrm {Uniform}[0,1]$. Red lines: data-generating-process signal variables ($j_1$, $j_2$, $j_3$). Blue lines: data-generating-process null variables ($3$--$9$). All seven blue lines in the centre panel sit on the $y=0$ axis at every $V$}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {C2}{\ignorespaces V-sweep summary on the simulation of Section \ref {sec:simulation_experiments} (predindex $j_3$, $\mathrm {nrepp}=500$). Rejection rate at $\alpha =0.05$ is the empirical Type-I rate (for null variables) or power (for signal variables). The null-group rows aggregate variables $3$--$9$ by averaging.}}{15}{table.caption.12}\protected@file@percent }
\newlabel{tab:supp_v_sweep}{{C2}{15}{V-sweep summary on the simulation of Section \ref {sec:simulation_experiments} (predindex $j_3$, $\mathrm {nrepp}=500$). Rejection rate at $\alpha =0.05$ is the empirical Type-I rate (for null variables) or power (for signal variables). The null-group rows aggregate variables $3$--$9$ by averaging}{table.caption.12}{}}
