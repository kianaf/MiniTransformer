\newlabel{eq:gate}{{A2}{11}{}{equation.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A1}{\ignorespaces Predictability gate \eqref  {eq:gate} on the simulation of Section \ref {sec:simulation_experiments} ($n_{\mathrm {train}}=200$, $n_{\mathrm {test}}=1000$). The gate decision uses the marginal-mean comparison only; the regression column is reported for transparency. The MiniTransformer beats the marginal-mean baseline by a substantial margin on the only generatively-predictable target ($j_3$): $0.102$ vs $0.227$. Variable $9$ marginally passes by a $0.001$ MSE difference and is best interpreted as a chance crossing in finite test data.}}{12}{table.caption.7}\protected@file@percent }
\newlabel{tab:supp_gate}{{A1}{12}{Predictability gate \eqref {eq:gate} on the simulation of Section \ref {sec:simulation_experiments} ($n_{\mathrm {train}}=200$, $n_{\mathrm {test}}=1000$). The gate decision uses the marginal-mean comparison only; the regression column is reported for transparency. The MiniTransformer beats the marginal-mean baseline by a substantial margin on the only generatively-predictable target ($j_3$): $0.102$ vs $0.227$. Variable $9$ marginally passes by a $0.001$ MSE difference and is best interpreted as a chance crossing in finite test data}{table.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S2}Empirical null calibration of the permutation test}{12}{Appendix.1.B}\protected@file@percent }
\newlabel{sec:supp_calibration}{{S2}{12}{}{Appendix.1.B}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B1}{\ignorespaces Per-variable p-value distributions over $\mathrm {nrepp}=500$ repetitions of the permutation test, with signal target $j_3$ ($\mathrm {predindex}=2$) and visit-sample size $V=5$. Red panels: variables that carry the true context pattern ($j_1$, $j_2$, $j_3$). Blue panels: data-generating-process-null variables ($3$--$9$). The grey dashed line marks the expected count per bin under a uniform distribution on $[0,1]$. Empirical Type-I rate at $\alpha =0.05$ is $0.000$ across all seven null variables.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:supp_calibration_signal_hist}{{B1}{12}{Per-variable p-value distributions over $\mathrm {nrepp}=500$ repetitions of the permutation test, with signal target $j_3$ ($\mathrm {predindex}=2$) and visit-sample size $V=5$. Red panels: variables that carry the true context pattern ($j_1$, $j_2$, $j_3$). Blue panels: data-generating-process-null variables ($3$--$9$). The grey dashed line marks the expected count per bin under a uniform distribution on $[0,1]$. Empirical Type-I rate at $\alpha =0.05$ is $0.000$ across all seven null variables}{figure.caption.8}{}}
\BKM@entry{id=19,open,dest={417070656E6469782E312E43},srcline={781}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {B2}{\ignorespaces Quantile-quantile plots of the empirical p-value distributions in Figure \ref {fig:supp_calibration_signal_hist} against $\mathrm {Uniform}[0,1]$, for all ten variables. Red panels: data-generating-process signal variables ($j_1$, $j_2$, $j_3$); the empirical quantile curve falls well below the $45^\circ $ line, indicating an excess of small p-values (i.e.\ power). Blue panels: data-generating-process null variables ($3$--$9$); the empirical quantile curve sits systematically above the $45^\circ $ line, the conservative shift predicted by the analysis of Section \ref {sec:statistical_testing}.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:supp_calibration_signal_qq}{{B2}{13}{Quantile-quantile plots of the empirical p-value distributions in Figure \ref {fig:supp_calibration_signal_hist} against $\mathrm {Uniform}[0,1]$, for all ten variables. Red panels: data-generating-process signal variables ($j_1$, $j_2$, $j_3$); the empirical quantile curve falls well below the $45^\circ $ line, indicating an excess of small p-values (i.e.\ power). Blue panels: data-generating-process null variables ($3$--$9$); the empirical quantile curve sits systematically above the $45^\circ $ line, the conservative shift predicted by the analysis of Section \ref {sec:statistical_testing}}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S3}Sensitivity to the visit-sample size $V$}{13}{Appendix.1.C}\protected@file@percent }
