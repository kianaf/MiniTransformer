\@writefile{lot}{\contentsline {table}{\numberline {D3}{\ignorespaces Predictability gate for LORA dataset D1 (\texttt  {ghq\_b\_sum}) on fold $0$ of the $10$-fold split. The gate (MT $<$ avg) passes for all $10$ targets, including the paper's chosen target \texttt  {ghq\_b\_sum}. The regression column is reported for transparency: on this single fold, regression marginally beats MT for the target ($0.166$ vs $0.184$), but the $10$-fold mean reported in Table~\ref {tab:real_data_comparison_with_baselines} of the main text has MT beating regression on average ($0.184$ vs $0.199$).}}{16}{table.caption.13}\protected@file@percent }
\newlabel{tab:supp_gate_lora_d1}{{D3}{16}{Predictability gate for LORA dataset D1 (\texttt {ghq\_b\_sum}) on fold $0$ of the $10$-fold split. The gate (MT $<$ avg) passes for all $10$ targets, including the paper's chosen target \texttt {ghq\_b\_sum}. The regression column is reported for transparency: on this single fold, regression marginally beats MT for the target ($0.166$ vs $0.184$), but the $10$-fold mean reported in Table~\ref {tab:real_data_comparison_with_baselines} of the main text has MT beating regression on average ($0.184$ vs $0.199$)}{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {D4}{\ignorespaces Predictability gate for LORA dataset D2 (\texttt  {ghq\_sum}) on fold $0$ of the $10$-fold split. The gate (MT $<$ avg) passes for all $10$ targets, including the paper's chosen target \texttt  {ghq\_sum} which beats avg by $0.224 \to 0.183$ and additionally beats regression ($0.192$).}}{16}{table.caption.14}\protected@file@percent }
\newlabel{tab:supp_gate_lora_d2}{{D4}{16}{Predictability gate for LORA dataset D2 (\texttt {ghq\_sum}) on fold $0$ of the $10$-fold split. The gate (MT $<$ avg) passes for all $10$ targets, including the paper's chosen target \texttt {ghq\_sum} which beats avg by $0.224 \to 0.183$ and additionally beats regression ($0.192$)}{table.caption.14}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S5}V-sweep and gate on the PBC2 cohort}{16}{Appendix.1.E}\protected@file@percent }
\newlabel{sec:supp_pbc2}{{S5}{16}{}{Appendix.1.E}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {D5}{\ignorespaces Sensitivity of the permutation test to the visit-sample size $V$ on LORA dataset D1 (\texttt  {ghq\_b\_sum}, fold $0$). Left: mean p-value per candidate context across $\mathrm {nrepp}=500$ repetitions. Centre: empirical rejection rate at $\alpha =0.05$. Right: Kolmogorov-Smirnov distance to $\mathrm {Uniform}[0,1]$. Red line: the target variable used as its own context (\texttt  {ghq\_b\_sum}). Blue lines: candidate context variables. Variables flagged as significant context (e.g.\ \texttt  {dh\_38}) become more so with $V$; unflagged variables (e.g.\ \texttt  {le\_8}) stay flat or become more conservative.}}{17}{figure.caption.15}\protected@file@percent }
\newlabel{fig:supp_v_sweep_lora_d1}{{D5}{17}{Sensitivity of the permutation test to the visit-sample size $V$ on LORA dataset D1 (\texttt {ghq\_b\_sum}, fold $0$). Left: mean p-value per candidate context across $\mathrm {nrepp}=500$ repetitions. Centre: empirical rejection rate at $\alpha =0.05$. Right: Kolmogorov-Smirnov distance to $\mathrm {Uniform}[0,1]$. Red line: the target variable used as its own context (\texttt {ghq\_b\_sum}). Blue lines: candidate context variables. Variables flagged as significant context (e.g.\ \texttt {dh\_38}) become more so with $V$; unflagged variables (e.g.\ \texttt {le\_8}) stay flat or become more conservative}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {D6}{\ignorespaces Sensitivity of the permutation test to the visit-sample size $V$ on LORA dataset D2 (\texttt  {ghq\_sum}, fold $0$), $\mathrm {nrepp}=500$. The same qualitative pattern as in Figure \ref {fig:supp_v_sweep_lora_d1} is observed: signal-bearing contexts become more significant with $V$; the remaining contexts stay flat. Top-ranked contexts at $V=7$ are \texttt  {dh\_37}, \texttt  {dh\_38}, \texttt  {le\_17}, \texttt  {dh\_46}, in close agreement with Table \ref {tab:real_data_statistical_testing} of the main text.}}{17}{figure.caption.16}\protected@file@percent }
\newlabel{fig:supp_v_sweep_lora_d2}{{D6}{17}{Sensitivity of the permutation test to the visit-sample size $V$ on LORA dataset D2 (\texttt {ghq\_sum}, fold $0$), $\mathrm {nrepp}=500$. The same qualitative pattern as in Figure \ref {fig:supp_v_sweep_lora_d1} is observed: signal-bearing contexts become more significant with $V$; the remaining contexts stay flat. Top-ranked contexts at $V=7$ are \texttt {dh\_37}, \texttt {dh\_38}, \texttt {le\_17}, \texttt {dh\_46}, in close agreement with Table \ref {tab:real_data_statistical_testing} of the main text}{figure.caption.16}{}}
