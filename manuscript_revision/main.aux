\@writefile{lot}{\contentsline {table}{\numberline {E5}{\ignorespaces Predictability gate for PBC2 on fold $0$ of the $10$-fold split. All $10$ targets pass the gate (MT $<$ avg). The chosen target \texttt  {bili\_high} (elevated bilirubin) passes by a wide margin: $0.033$ vs $0.288$ for the average baseline -- a roughly $9$-fold reduction in test-set MSE -- and is essentially tied with regression ($0.034$).}}{18}{table.caption.17}\protected@file@percent }
\newlabel{tab:supp_gate_pbc2}{{E5}{18}{Predictability gate for PBC2 on fold $0$ of the $10$-fold split. All $10$ targets pass the gate (MT $<$ avg). The chosen target \texttt {bili\_high} (elevated bilirubin) passes by a wide margin: $0.033$ vs $0.288$ for the average baseline -- a roughly $9$-fold reduction in test-set MSE -- and is essentially tied with regression ($0.034$)}{table.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {E7}{\ignorespaces Sensitivity of the permutation test to the visit-sample size $V$ on PBC2 (fold $0$, target \texttt  {bili\_high}). Left: mean p-value per candidate context across $\mathrm {nrepp}=500$ repetitions. Centre: empirical rejection rate at $\alpha =0.05$. Right: Kolmogorov-Smirnov distance to $\mathrm {Uniform}[0,1]$. Red line: target variable used as its own context; blue lines: candidate context variables. Variables that are flagged at the smallest $V$ become more significant with $V$; non-flagged variables stay near the nominal level or become more conservative. The top-ranked contexts (\texttt  {spiders}, \texttt  {platelet\_low}, \texttt  {albumin\_low}, \texttt  {edema\_present}) form the textbook clinical signature of advanced liver disease that predicts bilirubin elevation.}}{18}{figure.caption.18}\protected@file@percent }
\newlabel{fig:supp_v_sweep_pbc2}{{E7}{18}{Sensitivity of the permutation test to the visit-sample size $V$ on PBC2 (fold $0$, target \texttt {bili\_high}). Left: mean p-value per candidate context across $\mathrm {nrepp}=500$ repetitions. Centre: empirical rejection rate at $\alpha =0.05$. Right: Kolmogorov-Smirnov distance to $\mathrm {Uniform}[0,1]$. Red line: target variable used as its own context; blue lines: candidate context variables. Variables that are flagged at the smallest $V$ become more significant with $V$; non-flagged variables stay near the nominal level or become more conservative. The top-ranked contexts (\texttt {spiders}, \texttt {platelet\_low}, \texttt {albumin\_low}, \texttt {edema\_present}) form the textbook clinical signature of advanced liver disease that predicts bilirubin elevation}{figure.caption.18}{}}
